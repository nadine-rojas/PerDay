    <button class="btn ghost block" id="lock-cancel" type="button" hidden style="margin-top:10px">Cancelar</button>
    <button class="btn ghost block" id="lock-reset" type="button" hidden style="margin-top:10px">Olvidé mi patrón: borrar todo</button>
  </div>
</div>

<div id="bday" hidden>
  <div class="card bday-c" role="dialog" aria-modal="true" aria-labelledby="bday-t">
    <div class="confetti" id="confetti" aria-hidden="true"></div>
    <div class="big" id="bday-e" aria-hidden="true">🎂</div>
    <h2 id="bday-t"></h2>
    <p id="bday-m" style="margin:0"></p>
    <div class="gifts" id="bday-g"></div>
    <button class="btn block" id="bday-ok" type="button">¡Gracias! 💖</button>
    <button class="btn ghost block" id="bday-use" type="button" style="margin-top:10px">Estrenar mis regalos</button>
  </div>
</div>
<div id="dlg" hidden>
  <div class="card dlg" role="dialog" aria-modal="true" aria-labelledby="dlg-t">
    <h2 id="dlg-t"></h2>
    <p class="muted" id="dlg-p"></p>
    <div class="btns"><button class="btn" id="dlg-ok" type="button"></button><button class="btn ghost" id="dlg-no" type="button">Cancelar</button></div>
  </div>
</div>
<script>
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
