<!doctype html>
<html lang="es" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#A99BE0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Estimar menarca">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>Estimar menarca</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<style>
:root{--bg:#F9F7FD;--card:#fff;--text:#2F2B45;--muted:#6B6686;--line:#ECE8F6;--accent:#A99BE0;--grad:linear-gradient(135deg,#D3CAF6,#F8CFE0);--nav:linear-gradient(135deg,#C8EBDD,#C3DCF3);--shadow:0 2px 14px rgba(110,95,170,.08)}
[data-theme=dark]{--bg:#221F3A;--card:#2C2948;--text:#EFEAFB;--muted:#C9C3E6;--line:#403B68;--shadow:0 2px 14px rgba(0,0,0,.25)}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;font:400 16px/1.55 Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--text);min-height:100vh;-webkit-tap-highlight-color:transparent}
#bgfx{position:fixed;inset:0;z-index:-3;background:var(--bg);background-size:cover;background-position:center;background-attachment:fixed}
#veil{position:fixed;inset:0;z-index:-2;display:none}
#sparkles{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.sp{position:absolute;border-radius:50%;background:#fff;box-shadow:0 0 8px #fff,0 0 14px #C9B8FF;opacity:0;animation:tw 4s ease-in-out infinite}
.sp.l{background:#E4DAFF}
@keyframes tw{0%,100%{opacity:.05;transform:scale(.7)}50%{opacity:.85;transform:scale(1)}}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes breathe{0%,100%{transform:scale(.6)}50%{transform:scale(1)}}
@keyframes fall{to{transform:translateY(620px) rotate(360deg)}}
@keyframes pop{0%{transform:scale(.4)}60%{transform:scale(1.15)}100%{transform:scale(1)}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.sp{display:none}}
.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:calc(env(safe-area-inset-top,0px) + 10px) 16px 10px;background:rgba(249,247,253,.9);backdrop-filter:blur(10px)}
[data-theme=dark] .top{background:rgba(34,31,58,.9)}
.brand{font-weight:700;font-size:17px;display:flex;gap:8px;align-items:center}
.ctrls{display:flex;gap:8px;align-items:center;margin-left:auto}
main{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:12px 16px calc(120px + env(safe-area-inset-bottom,0px))}
.view{display:none}
.view.on{display:block;animation:fade .3s ease}
h1{font-size:26px;margin:8px 0 6px;line-height:1.2;font-weight:700}
h2{font-size:18px;margin:0 0 10px;line-height:1.3;font-weight:700}
h3{font-weight:600}
.muted{color:var(--muted);margin:0 0 12px}
.card{background:var(--card);border-radius:24px;padding:22px;box-shadow:var(--shadow);margin-bottom:16px}
.grid{display:grid;gap:16px}
.grid>.card,.stack .card{margin:0}
.stack{display:grid;gap:16px;align-content:start}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
#day-card{scroll-margin-top:80px}
.val{font-weight:700;font-size:22px;margin:0 0 4px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:0;border-radius:16px;background:var(--grad);color:#3F3560;font:inherit;font-weight:600;font-size:15px;cursor:pointer;text-decoration:none}
.btn:active{transform:scale(.98)}
.btn.ghost{background:transparent;color:var(--text);box-shadow:inset 0 0 0 1.5px var(--line)}
.btn.block{width:100%}
button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,textarea:focus-visible{outline:3px solid #9B8CF0;outline-offset:2px}
fieldset{border:0;padding:0;margin:0 0 20px;min-width:0}
legend{font-weight:600;margin-bottom:10px;padding:0}
select,input[type=text],input[type=time],input[type=number]{width:100%;min-height:48px;border-radius:14px;border:1.5px solid var(--line);background:var(--card);color:var(--text);font:inherit;padding:0 14px}
textarea{width:100%;min-height:84px;border-radius:14px;border:1.5px solid var(--line);background:var(--card);color:var(--text);font:inherit;padding:10px 14px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opts label{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:14px;border:1.5px solid var(--line);cursor:pointer;background:var(--bg)}
.opts input{position:absolute;opacity:0;width:0;height:0;margin:0}
.opts label:has(input:checked){border-color:var(--accent);background:var(--card);font-weight:600;box-shadow:inset 0 0 0 1px var(--accent)}
.opts label:has(input:focus-visible){outline:3px solid #9B8CF0;outline-offset:2px}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px}
.tile{position:relative;cursor:pointer;display:block}
.tile input{position:absolute;opacity:0;width:0;height:0;margin:0}
.tile span{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:78px;padding:8px 4px;text-align:center;font-size:12.5px;font-weight:600;line-height:1.25;border-radius:16px;border:1.5px solid var(--line);background:var(--bg)}
.tile b{font-size:24px;font-weight:400;line-height:1}
.tile:has(input:checked) span{border-color:var(--accent);background:var(--card);box-shadow:inset 0 0 0 1px var(--accent)}
.tile:has(input:focus-visible) span{outline:3px solid #9B8CF0;outline-offset:2px}
.moods{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.mood{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:68px;border-radius:16px;border:1.5px solid var(--line);background:var(--bg);color:var(--text);font:inherit;font-size:12.5px;font-weight:600;cursor:pointer}
.mood b{font-size:24px;font-weight:400;line-height:1.1}
.mood.on{border-color:var(--accent);background:var(--card);box-shadow:inset 0 0 0 1px var(--accent)}
.err{color:#C2185B;font-weight:600;margin:0 0 12px}
[data-theme=dark] .err{color:#F8BBD0}
.res{background:var(--grad);color:#3F3560;border-radius:24px;padding:24px;margin-bottom:16px}
.res p{margin:0 0 10px}
.res .est{font-size:21px;font-weight:700;line-height:1.3}
.warn{background:#FFF3E0;color:#5D3A00;border:1.5px solid #FFB74D}
[data-theme=dark] .warn{background:#4A3B1E;color:#FFE9C2;border-color:#B07C2E}
.stages{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:8px 0}
.stage{height:10px;border-radius:99px;background:var(--line)}
.stage.on{background:var(--nav)}
.stage-lbl{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:14px;color:var(--muted);margin-bottom:10px}
.stage-lbl .on{color:var(--text);font-weight:700}
.disc{font-size:15px}
.disc p{margin:0}
details{background:var(--bg);border-radius:14px;padding:4px 16px;margin-bottom:10px}
summary{font-weight:600;cursor:pointer;min-height:44px;display:flex;align-items:center}
details p{margin:0 0 12px;color:var(--muted)}
.breath{width:70px;height:70px;border-radius:50%;background:var(--nav);margin-top:8px;animation:breathe 8s ease-in-out infinite}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{min-height:40px;padding:0 14px;border-radius:99px;border:0;background:var(--bg);color:var(--text);font:inherit;font-weight:600;font-size:14px;cursor:pointer}
.msg-form{display:flex;gap:8px;margin-top:12px}
.msg-form input{flex:1}
.switch-row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}
.switch-row p{margin:0}
.sw{position:relative;width:56px;height:32px;border-radius:99px;border:0;background:var(--line);cursor:pointer;flex:none;padding:0}
.sw::after{content:"";position:absolute;top:4px;left:4px;width:24px;height:24px;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.2);transition:transform .3s ease}
.sw[aria-checked=true]{background:var(--nav)}
.sw[aria-checked=true]::after{transform:translateX(24px)}
.chart{display:flex;align-items:flex-end;gap:6px;height:150px;margin-bottom:10px}
.bar{flex:1;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:4px;font-size:12px;color:var(--muted)}
.bar em{font-style:normal;font-size:16px;line-height:1}
.bar i{display:block;width:100%;max-width:30px;border-radius:10px 10px 4px 4px;background:var(--nav)}
.avatar{position:relative;width:132px;height:132px;margin:10px auto 18px}
.av{width:100%;height:100%;border-radius:50%;overflow:hidden;background:var(--grad);display:grid;place-items:center;color:#3F3560;font-size:44px;font-weight:700}
.av img{width:100%;height:100%;object-fit:cover}
.av-frame{position:absolute;inset:-12px;width:calc(100% + 24px);height:calc(100% + 24px);pointer-events:none}
.av-frame svg,.fr svg{width:100%;height:100%}
.btns{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:12px}
.crop{width:240px;height:240px;margin:12px auto;border-radius:50%;overflow:hidden;position:relative;background:#ddd;touch-action:none;cursor:grab}
.crop img{position:absolute;max-width:none;user-select:none;-webkit-user-drag:none;pointer-events:none}
.zoom{display:block;margin-bottom:12px}
.zoom input{width:100%;accent-color:#A99BE0}
.frames{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.fr{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 4px;border-radius:14px;border:1.5px solid transparent;background:var(--bg);color:var(--text);font:inherit;font-size:12px;cursor:pointer}
.fr[aria-pressed=true]{border-color:var(--accent)}
.fr svg{width:44px;height:44px;flex:none}
.bgs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.bgo{min-height:60px;border-radius:14px;border:1.5px solid transparent;font:inherit;font-size:13px;font-weight:600;color:#2D2A44;cursor:pointer;display:flex;align-items:flex-end;justify-content:center;padding:6px;box-shadow:inset 0 0 0 1px var(--line)}
.bgo[aria-pressed=true]{border-color:var(--accent)}
.bnav{position:fixed;left:0;right:0;bottom:0;z-index:30;display:grid;grid-template-columns:repeat(5,1fr);height:calc(76px + env(safe-area-inset-bottom,0px));padding-bottom:env(safe-area-inset-bottom,0px);background:var(--card);border-radius:24px 24px 0 0;box-shadow:0 -4px 20px rgba(110,95,170,.1)}
.navbtn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border:0;background:none;color:var(--muted);font:inherit;font-size:11.5px;font-weight:600;cursor:pointer;padding:6px 2px;min-height:44px}
.navbtn.on{color:var(--text);font-weight:700}
.navbtn.on .i{stroke:#8E7FD1}
.navbtn.mid{padding-top:36px}
.fab{position:absolute;left:50%;top:-24px;transform:translateX(-50%);width:58px;height:58px;border-radius:50%;border:4px solid var(--bg);background:var(--grad);color:#3F3560;display:grid;place-items:center;cursor:pointer;box-shadow:0 6px 16px rgba(169,155,224,.35)}
.fab .i{width:26px;height:26px}
.btn-install{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 14px 0 6px;border:1.5px solid var(--line);border-radius:999px;background:var(--card);color:var(--muted);font:inherit;font-weight:600;font-size:14px;cursor:pointer;flex:none}
.bi-circ{width:30px;height:30px;border-radius:50%;background:var(--bg);display:grid;place-items:center}
.bi-circ .i{width:18px;height:18px}
.btn-install:disabled{opacity:.7;cursor:default}
.toggle{position:relative;width:96px;height:38px;border-radius:99px;border:1.5px solid var(--line);background:var(--card);font:inherit;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;padding:0;flex:none}
.toggle .tl{position:absolute;top:50%;transform:translateY(-50%);left:12px}
.toggle[data-mode=dark] .tl{left:auto;right:12px}
.knob{position:absolute;top:3px;left:calc(100% - 33px);width:30px;height:30px;border-radius:50%;background:var(--bg);display:grid;place-items:center;transition:left .3s ease}
.toggle[data-mode=dark] .knob{left:3px}
.knob .i{width:18px;height:18px;stroke-width:2.2}
.knob .sun{stroke:#E0A82E}
.knob .moon{stroke:#8FB4F0}
.toggle[data-mode=light] .moon,.toggle[data-mode=dark] .sun{display:none}
.tip{position:fixed;left:16px;right:16px;bottom:calc(92px + env(safe-area-inset-bottom,0px));z-index:40;max-width:420px;margin:0 auto;display:flex;align-items:center;gap:12px;padding:14px}
.tip p{margin:0;flex:1}
.tip .btn{min-height:40px;padding:0 12px}
.burger{width:44px;height:44px;border-radius:14px;border:1.5px solid var(--line);background:var(--card);display:grid;place-items:center;cursor:pointer;color:var(--text);flex:none}
@media (max-width:520px){.bi-txt{display:none}.btn-install{padding:0 6px}.toggle{width:84px}.brand{font-size:15px}}
@media (min-width:768px){
  .bnav{left:50%;right:auto;transform:translateX(-50%);width:min(680px,calc(100% - 32px));bottom:14px;height:80px;padding-bottom:0;border-radius:28px}
  main{padding:20px 36px 140px}
  .grid{grid-template-columns:repeat(3,1fr);align-items:start}
  .span2{grid-column:span 2}
  .span3{grid-column:1/-1}
  .tip{bottom:112px}
}
/* Calendario */
.cal-head{display:flex;align-items:center;gap:8px;margin-bottom:12px}
.cal-head h2{margin:0;flex:1;text-align:center;text-transform:capitalize;font-size:19px}
.cbtn{width:44px;height:44px;flex:none;border-radius:50%;border:0;background:var(--bg);color:var(--text);font-size:22px;cursor:pointer}
.cal-dow,.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.cal-dow span{font-size:12px;font-weight:600;color:var(--muted);padding:4px 0}
.day{position:relative;min-height:52px;border-radius:14px;border:1.5px solid transparent;background:transparent;color:var(--text);font:600 15px/1 Inter,system-ui,sans-serif;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:2px 0 9px}
.day.today{border-color:var(--accent)}
.day.pred{border:1.5px dashed #E89BBB}
.day.sel{background:var(--grad);color:#3F3560}
.day em{font-style:normal;font-size:14px;line-height:1}
.per{position:absolute;left:50%;bottom:5px;transform:translateX(-50%);width:7px;height:7px;border-radius:50%;background:#EC6A9B}
.per.ligera{opacity:.5}
.per.fuerte{width:11px;height:7px;border-radius:4px;background:#C2185B}
.fl{position:absolute;top:5px;right:6px;width:6px;height:6px;border-radius:50%;background:#7FB8E8}
.sy{position:absolute;top:5px;left:6px;width:6px;height:6px;border-radius:50%;background:#A99BE0}
.bd{position:absolute;top:1px;left:50%;transform:translateX(-50%);font-size:10px;line-height:1}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:14px;font-size:12.5px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{display:inline-block;width:9px;height:9px;border-radius:50%}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12px 8px;border-radius:16px;background:var(--bg)}
.stat b{font-size:17px;font-weight:700;line-height:1.2;text-transform:capitalize}
.stat span{font-size:12.5px;color:var(--muted)}
.stat.wide{grid-column:1/-1}
.tl{position:relative;height:14px;border-radius:99px;background:var(--line);margin:14px 0 4px}
.tl-w{position:absolute;top:0;bottom:0;border-radius:99px;background:linear-gradient(90deg,#F8CFE0,#EC9FBF)}
.tl-n{position:absolute;left:-2px;top:-3px;width:20px;height:20px;border-radius:50%;background:var(--accent);border:3px solid var(--card)}
.tl-l{display:flex;justify-content:space-between;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:12px}
.steps{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
.steps span{font-size:13px;font-weight:600;padding:4px 10px;border-radius:99px;background:var(--bg);color:var(--muted)}
.steps span.ok{background:#D6F0E4;color:#245A44}
/* Pronóstico y tips */
.pron-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.pron-top b{font-size:36px;line-height:1;font-weight:700}
.pill{display:inline-block;padding:4px 12px;border-radius:99px;font-size:13px;font-weight:700}
.pill.baja{background:#D6F0E4;color:#245A44}
.pill.media{background:#FFF0CF;color:#6B4A00}
.pill.alta{background:#FAD4E4;color:#7A2450}
.pbar{height:14px;border-radius:99px;background:var(--line);overflow:hidden}
.pbar i{display:block;height:100%;width:var(--w,0%);background:linear-gradient(90deg,#BDE8D6,#BFD9F2 45%,#F2B6CF);border-radius:99px;transition:width .5s ease}
.pbar-l{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin:6px 0 12px}
.tipc{background:var(--bg);border-radius:16px;padding:12px 14px;margin-bottom:10px}
.tipc b{display:block;margin-bottom:4px}
.tipc p{margin:0;color:var(--muted);font-size:14.5px}
.foot{font-size:12.5px;color:var(--muted);margin:4px 0 0}
#day-tips:empty{display:none}
#day-tips{margin-top:16px}
/* Rutinas */
.notif{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--bg);border-radius:16px;padding:12px 14px;margin-bottom:14px}
.notif p{margin:0;flex:1;min-width:200px}
#rut-list{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}
.rut{background:var(--bg);border-radius:18px;padding:14px}
.rut-h{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.rut-h h3{margin:0;flex:1;font-size:16px}
.rut-e{font-size:26px;line-height:1}
.rdel{min-height:40px;padding:0 10px}
.rut-p,.rmini{display:flex;align-items:center;gap:12px}
.rmini{margin-bottom:10px}
.rmini>span{font-size:22px}
.rut-m{flex:1;min-width:0}
.rut-m b{display:block;font-size:15px;margin-bottom:4px}
.rmini small{font-weight:600;color:var(--muted);margin-left:6px}
.rut .muted{margin:8px 0 0;font-size:14px}
.rbar{height:10px;border-radius:99px;background:var(--line);overflow:hidden}
.rbar i{display:block;height:100%;width:var(--w,0%);background:var(--nav);border-radius:99px;transition:width .3s ease}
.rbtn{width:44px;height:44px;flex:none;border-radius:50%;border:0;background:var(--grad);color:#3F3560;font:inherit;font-size:24px;font-weight:600;line-height:1;cursor:pointer}
.rbtn.minus{background:var(--line);color:var(--text)}
.rbtn:active{transform:scale(.94)}
.rut-cfg{display:flex;flex-wrap:wrap;gap:10px;margin:10px 0 0}
.rut-cfg label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600;flex:1;min-width:100px}
fieldset.miss{outline:2px dashed #F06292;outline-offset:8px;border-radius:12px}
fieldset.miss legend{color:#C2185B}
[data-theme=dark] fieldset.miss legend{color:#F8BBD0}
/* Celebraciones */
#bday{position:fixed;inset:0;z-index:90;background:rgba(40,30,70,.45);display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.bday-c{position:relative;overflow:hidden;max-width:380px;width:100%;text-align:center;margin:auto}
.bday-c>*:not(.confetti){position:relative;z-index:1}
.confetti{position:absolute;inset:0;pointer-events:none;z-index:0}
.cf{position:absolute;top:-28px;font-size:20px;opacity:.9;animation:fall 4s linear infinite}
.bday-c .big{font-size:60px;line-height:1.1;animation:pop .6s ease}
.gifts{display:grid;gap:8px;margin:12px 0}
.gift{display:flex;align-items:center;gap:10px;background:var(--bg);border-radius:14px;padding:10px 12px;text-align:left}
.gift>span{font-size:26px;line-height:1}
.gift small{color:var(--muted)}
.av-badge{position:absolute;right:-6px;bottom:-6px;width:42px;height:42px;border-radius:50%;background:var(--card);box-shadow:var(--shadow);display:grid;place-items:center;font-size:22px}
.fest{display:flex;align-items:center;gap:12px;background:var(--bg);border-radius:16px;padding:10px 12px;margin-bottom:8px}
.fest>span{font-size:26px}
.fest>div{flex:1;min-width:0}
.fest small{display:block;color:var(--muted)}
.fest .btn{min-height:40px;padding:0 14px;font-size:14px}
/* Menú, bloqueo y diálogo */
.scrim{position:fixed;inset:0;background:rgba(20,15,50,.35);z-index:50}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(300px,86vw);background:var(--card);z-index:51;padding:calc(env(safe-area-inset-top,0px) + 16px) 16px 24px;box-shadow:-10px 0 30px rgba(0,0,0,.2);transform:translateX(105%);transition:transform .3s ease;display:flex;flex-direction:column;gap:8px;overflow-y:auto}
.drawer.on{transform:none}
.dr-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.dr-item{min-height:48px;text-align:left;border:0;border-radius:14px;background:var(--bg);color:var(--text);font:inherit;font-weight:600;padding:0 14px;cursor:pointer}
.dr-item.danger{color:#C2185B}
#lock,#dlg{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
#lock{z-index:200;background:var(--bg)}
#dlg{z-index:150;background:rgba(20,15,50,.45)}
.lockc,.dlg{width:100%;max-width:380px;margin:auto}
.dlg .btns .btn{flex:1}
.pat{position:relative;width:min(260px,70vw);aspect-ratio:1;margin:16px auto;display:grid;grid-template-columns:repeat(3,1fr);touch-action:none;user-select:none;-webkit-user-select:none}
.pat svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.pat polyline{stroke:var(--accent);stroke-width:5;stroke-linecap:round;stroke-linejoin:round;opacity:.75}
.pat[data-state=err] polyline{stroke:#E57393}
.pdot{display:grid;place-items:center;border:0;background:none;padding:0;cursor:pointer}
.pdot i{width:16px;height:16px;border-radius:50%;background:var(--line);box-shadow:0 0 0 0 transparent;transition:box-shadow .15s,background .15s}
.pdot.on i{background:var(--accent);box-shadow:0 0 0 10px rgba(169,155,224,.28)}
.pat[data-state=err] .pdot.on i{background:#E57393;box-shadow:0 0 0 10px rgba(229,115,147,.28)}
.pdot:focus-visible{outline:3px solid #9B8CF0;outline-offset:-6px;border-radius:50%}
.mapa{width:100%;height:auto;display:block;margin:4px 0}
.mapa text{font:600 12px Inter,sans-serif;fill:var(--muted)}
@media (max-width:380px){.frames{grid-template-columns:repeat(3,1fr)}.moods{gap:6px}}
</style>
</head>
<body>
<div id="bgfx"></div><div id="veil"></div><div id="sparkles"></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
