  <div class="dr-head"><div class="brand"><span aria-hidden="true">🌙</span> Menú</div><button class="btn ghost" id="dr-x" type="button" aria-label="Cerrar menú" style="min-height:44px;padding:0 14px">✕</button></div>
  <button class="dr-item" data-go="inicio" type="button">Mi calendario</button>
