function bdayInfo(){
  if(!bday) return null;
  const n=new Date(), t=new Date(n.getFullYear(),n.getMonth(),n.getDate(),12);
  let b=new Date(n.getFullYear(),bday.m-1,bday.d,12), diff=Math.round((b-t)/864e5);
  if(diff<-6){b=new Date(n.getFullYear()+1,bday.m-1,bday.d,12);diff=Math.round((b-t)/864e5)}
  return {diff,year:b.getFullYear()};
}
function renderBday(){
  const D=$('#bd-d'),M=$('#bd-m');
  if(!D.options.length){
    D.innerHTML='<option value="">Día</option>'+Array.from({length:31},(_,i)=>`<option value="${i+1}">${i+1}</option>`).join('');
    M.innerHTML='<option value="">Mes</option>'+MESES.map((x,i)=>`<option value="${i+1}">${x}</option>`).join('');
