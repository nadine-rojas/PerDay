  if(i) t=i.diff===0?'¡Hoy es tu cumpleaños! 🎉':i.diff<0?`Tu cumpleaños fue hace ${-i.diff} ${i.diff===-1?'día':'días'}.`:`Tu cumpleaños es el ${bday.d} de ${MESES[bday.m-1]}. Faltan ${i.diff} ${i.diff===1?'día':'días'} 🎈`;
