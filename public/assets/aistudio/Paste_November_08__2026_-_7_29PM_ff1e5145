const S=240; let crop=null, drag=null;
function openCrop(src){
  const img=new Image();
  img.onload=()=>{
    crop={img,w:img.naturalWidth,h:img.naturalHeight,z:1,x:0,y:0};
    $('#crop-img').src=src; $('#zoom').value=1;
    $('#crop-box').hidden=false; layoutCrop();
  };
  img.onerror=()=>alert('No pude abrir esa imagen. Prueba con otra.');
  img.src=src;
}
function layoutCrop(){
  if(!crop) return;
  const s=Math.max(S/crop.w,S/crop.h)*crop.z;
  const W=crop.w*s,H=crop.h*s,mx=(W-S)/2,my=(H-S)/2;
  crop.x=Math.max(-mx,Math.min(mx,crop.x));
  crop.y=Math.max(-my,Math.min(my,crop.y));
  crop.s=s;
  const el=$('#crop-img');
  Object.assign(el.style,{width:W+'px',height:H+'px',left:((S-W)/2+crop.x)+'px',top:((S-H)/2+crop.y)+'px'});
}
function closeCrop(){crop=null;$('#crop-box').hidden=true;$('#f-up').value='';$('#f-cam').value=''}
function readFile(file,cb){const r=new FileReader();r.onload=()=>cb(r.result);r.readAsDataURL(file)}
function shrink(src,max,q,cb){
  const im=new Image();
  im.onload=()=>{
    const k=Math.min(1,max/Math.max(im.naturalWidth,im.naturalHeight));
    const c=document.createElement('canvas');
    c.width=Math.round(im.naturalWidth*k);c.height=Math.round(im.naturalHeight*k);
    const g=c.getContext('2d');g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);
    g.drawImage(im,0,0,c.width,c.height);
    cb(c.toDataURL('image/jpeg',q));
  };
  im.onerror=()=>alert('No pude abrir esa imagen. Prueba con otra.');
  im.src=src;
}

