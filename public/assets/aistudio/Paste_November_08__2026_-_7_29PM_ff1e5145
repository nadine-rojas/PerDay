</svg>

<header class="top">
  <div class="brand"><span aria-hidden="true">🌙</span> Estimar menarca</div>
  <div class="ctrls">
    <button class="btn-install" type="button"><span class="bi-circ"><svg class="i"><use href="#i-cloud"/></svg></span><span class="bi-txt">Instalar app</span></button>
    <button class="toggle" type="button" role="switch" aria-checked="false" data-mode="light" aria-label="Cambiar entre modo claro y oscuro"><span class="tl">Claro</span><span class="knob"><svg class="i sun"><use href="#i-sun"/></svg><svg class="i moon"><use href="#i-moon"/></svg></span></button>
    <button class="burger" id="burger" type="button" aria-label="Abrir menú" aria-expanded="false"><svg class="i"><use href="#i-menu"/></svg></button>
  </div>
</header>

<main>
  <!-- Inicio -->
  <section class="view on" id="v-inicio">
    <h1 class="sr">Mi calendario</h1>
    <div class="grid">
      <div class="card hoy">
        <h2>Hoy</h2>
        <p class="val" id="hoy-animo">Aún sin registrar</p>
        <p class="muted" id="hoy-etapa" style="margin:0">Haz una estimación</p>
        <p class="muted" id="hoy-bday" style="margin:6px 0 0" hidden></p>
        <button class="btn ghost" data-go="estimar" type="button" style="margin-top:14px">Estimar mi etapa</button>
      </div>

      <div class="card span2" id="pron-card">
        <h2>Pronóstico de los próximos 7 días</h2>
        <div id="pron"></div>
      </div>

      <div class="card span2" id="cal-card">
        <h2 class="sr">Calendario</h2>
        <p class="muted" style="margin:0 0 12px">Toca un día para anotar cómo estuvo.</p>
        <div class="cal-head"><button class="cbtn" id="cal-prev" type="button" aria-label="Mes anterior">‹</button><h2 id="cal-title"></h2><button class="cbtn" id="cal-next" type="button" aria-label="Mes siguiente">›</button></div>
        <div class="cal-dow"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
        <div class="cal" id="cal"></div>
        <div class="legend"><span><i style="background:#EC6A9B"></i>Menstruación</span><span><i style="background:#C2185B"></i>Fuerte</span><span><i style="background:#7FB8E8"></i>Flujo o manchas</span><span><i style="background:#A99BE0"></i>Molestias</span><span><i style="border:1.5px dashed #E89BBB"></i>Posible próxima</span></div>
      </div>

      <div class="stack">
        <div class="card" id="tips-card">
          <h2>Tu cuerpo te dice</h2>
          <div id="tips"></div>
          <p class="foot">Información general basada en KidsHealth y ACOG. No reemplaza a tu pediatra.</p>
        </div>
        <div class="card" id="menarca-card">
          <h2>Mi menarca</h2>
          <div id="menarca"></div>
        </div>
      </div>

      <div class="card span2" id="day-card">
        <h2 id="day-title"></h2>
        <fieldset><legend>¿Te vino la menstruación?</legend><div class="opts" id="reg-per"></div></fieldset>
        <fieldset id="int-box" hidden><legend>¿Qué tan fuerte fue?</legend><div class="opts" id="reg-int"></div></fieldset>
        <fieldset><legend>¿Cómo te sentiste?</legend><div class="moods" id="reg-moods"></div></fieldset>
        <fieldset><legend>¿Notaste alguna señal en tu cuerpo?</legend><div class="tiles" id="reg-mol"></div></fieldset>
        <fieldset><legend>¿Cómo fue tu flujo?</legend><div class="tiles" id="reg-flu"></div></fieldset>
        <textarea id="reg-nota" maxlength="200" placeholder="Nota (opcional)" aria-label="Nota"></textarea>
        <div id="day-tips"></div>
        <p class="muted" id="reg-ok" hidden style="margin:10px 0 0;font-weight:600" role="status"></p>
        <div class="btns" style="margin:14px 0 0;justify-content:flex-start"><button class="btn" id="reg-save" type="button">Guardar este día</button><button class="btn ghost" id="reg-del" type="button">Borrar este día</button></div>
      </div>

      <div class="stack">
        <div class="card" id="ritmo-card">
          <h2>Mi ritmo</h2>
          <div id="ritmo"></div>
          <p class="muted" style="margin:0;font-size:14px">Esto es solo una orientación, no un diagnóstico.</p>
        </div>
        <div class="card" id="rut-card">
          <h2>Rutinas de hoy</h2>
          <div id="rut-hoy"></div>
          <button class="btn ghost block" data-go="perfil" type="button">Cambiar mis rutinas</button>
        </div>
      </div>

      <div class="card">
        <h2>Mi ánimo de la semana</h2>
        <div class="chart" id="chart"></div>
        <p class="muted" id="hist-vacio">Aún no hay ánimos registrados. Elige cómo te sentiste en el calendario.</p>
        <button class="btn ghost block" id="hist-del" type="button">Borrar mis ánimos</button>
      </div>
    </div>
  </section>

  <!-- Estimar -->
  <section class="view" id="v-estimar">
    <div class="card" id="card-form" style="max-width:640px">
      <h2>Estimar</h2>
      <p class="muted">Responde con calma. No hay respuestas buenas ni malas.</p>
      <form id="f" novalidate>
        <fieldset>
          <legend>¿Cuántos años tienes?</legend>
          <div class="row">
            <select name="edad" id="edad" aria-label="Años"></select>
            <select name="meses" id="meses" aria-label="Meses"></select>
          </div>
        </fieldset>
        <div id="qs"></div>
        <p class="err" id="err" hidden>Responde todas las preguntas para ver tu estimación.</p>
        <button class="btn block" type="submit">Ver mi estimación</button>
      </form>
    </div>
    <div id="resultado" hidden style="max-width:640px"></div>
  </section>

  <!-- Qué esperar -->
  <section class="view" id="v-queesperar">
    <h1>Qué esperar</h1>
    <p class="muted">Cambios normales de la pubertad, explicados con calma.</p>
    <div class="grid" id="cards-que"></div>
  </section>

  <!-- Preguntas -->
  <section class="view" id="v-preguntas">
    <h1>Preguntas frecuentes</h1>
    <p class="muted">Lo que muchas niñas se preguntan.</p>
    <div class="card">
      <details><summary>¿Es normal que me llegue antes o después que a mis amigas?</summary><p>Sí. Cada cuerpo tiene su propio ritmo. Lo normal va de los 9 a los 16 años.</p></details>
      <details><summary>¿Duele la menstruación?</summary><p>Puede haber molestias leves en la parte baja del abdomen. Si el dolor es muy fuerte o no te deja hacer tus cosas, avisa a un adulto de confianza.</p></details>
      <details><summary>¿Cada cuánto llega?</summary><p>Al principio puede ser irregular. En las adolescentes, lo normal es que pasen entre 21 y 45 días entre una y otra. Con el tiempo se va haciendo más regular.</p></details>
      <details><summary>¿Qué hago si me llega en la escuela?</summary><p>Usa una toalla sanitaria si la tienes, avisa a una persona de confianza, como una maestra o una amiga, y pide ayuda. Es algo normal que le pasa a muchas niñas.</p></details>
      <details><summary>¿Va a doler la primera vez que me venga?</summary><p>Puede que sientas molestias leves, como cólicos en la parte baja del abdomen o cansancio. Hay niñas que casi no sienten nada y otras que sienten un poco más. Si el dolor es muy fuerte, no te deja hacer tus cosas o dura mucho, avisa a un adulto de confianza y habla con tu pediatra.</p></details>
      <details><summary>¿Cómo se ve la menstruación?</summary><p>Suele ser sangre de color rojo o café. Al principio puede ser poca y solo manchar, y después aumentar unos días. A veces tiene pequeños coágulos, lo cual es normal. Cada niña tiene su propio patrón.</p></details>
      <details><summary>¿Cómo sé que me va a venir pronto?</summary><p>Algunas señales son que te crezcan las mamas, que te salga vello, que tengas un estirón y que notes flujo blanco o transparente. La primera menstruación suele llegar unos 2 años después de que empiezan a crecer las mamas. Nadie puede decir el día exacto, pero si anotas en tu calendario, con el tiempo verás tu propio ritmo.</p></details>
      <details><summary>¿Qué es el flujo blanco?</summary><p>Es un líquido blanco o transparente que indica que el cuerpo se está preparando. Suele aparecer unos 6 meses antes de la primera menstruación. Si cambia de color, huele fuerte o pica, consulta a tu pediatra.</p></details>
      <details><summary>¿Cuándo debo consultar al pediatra?</summary><p>Si a los 15 años aún no te llegó, si el periodo dura más de 7 días, si empapas una toalla en menos de 2 horas, si pasan más de 45 días o menos de 21 entre un periodo y otro, o si el dolor es muy fuerte.</p></details>
    </div>
  </section>

  <!-- Mi perfil -->
  <section class="view" id="v-perfil">
    <h1>Mi perfil</h1>
    <p class="muted">Todo se guarda solo en este dispositivo. Ninguna foto sale de aquí.</p>
    <div class="grid">
      <div class="card">
        <h2>Foto</h2>
        <div class="avatar"><div class="av" id="av"></div><div class="av-frame" id="av-frame"></div><span class="av-badge" id="av-badge" hidden></span></div>
        <div class="btns">
          <button class="btn" id="b-up" type="button"><svg class="i"><use href="#i-img"/></svg>Subir foto</button>
          <button class="btn ghost" id="b-cam" type="button"><svg class="i"><use href="#i-cam"/></svg>Tomar foto</button>
          <button class="btn ghost" id="b-nofoto" type="button">Quitar</button>
        </div>
        <input type="file" id="f-up" accept="image/*" hidden>
        <input type="file" id="f-cam" accept="image/*" capture="user" hidden>
        <div id="crop-box" hidden>
          <p class="muted" style="text-align:center">Arrastra la foto y ajusta el zoom.</p>
          <div class="crop" id="crop"><img id="crop-img" alt=""></div>
          <label class="zoom">Zoom <input type="range" id="zoom" min="1" max="3" step="0.02" value="1"></label>
          <div class="btns">
            <button class="btn" id="crop-save" type="button">Usar esta foto</button>
            <button class="btn ghost" id="crop-cancel" type="button">Cancelar</button>
          </div>
        </div>
      </div>
      <div class="card">
        <h2>Marco</h2>
        <div class="frames" id="frames"></div>
      </div>
      <div class="card">
        <h2>Apodo o avatar</h2>
        <p class="muted">Opcional. No escribas tu nombre real.</p>
        <input type="text" id="nick" maxlength="20" placeholder="Por ejemplo: Luna" aria-label="Apodo">
      </div>
      <div class="card span2" id="card-bday">
        <h2>Mi cumpleaños 🎂</h2>
        <p class="muted">Cuando llegue tu día te felicito y te doy regalos diferentes cada año. Solo guardo el día y el mes, y solo en este dispositivo.</p>
        <div class="row" style="margin-bottom:10px"><select id="bd-d" aria-label="Día"></select><select id="bd-m" aria-label="Mes"></select></div>
        <p class="muted" id="bday-info" role="status" style="margin:0 0 12px"></p>
        <div class="btns" style="justify-content:flex-start"><button class="btn ghost" id="bday-test" type="button">Ver cómo será la sorpresa</button><button class="btn ghost" id="bday-del" type="button" hidden>Quitar fecha</button></div>
        <h3 style="margin:12px 0 8px;font-size:16px">Mis regalos</h3>
        <div class="gifts" id="regalos"></div>
      </div>
      <div class="card">
        <h2>Fiestas del año 🎉</h2>
        <p class="muted">Si abres la app en estas fechas, recibes un regalo especial que se queda en tu perfil.</p>
        <div id="fest-list"></div>
      </div>
      <div class="card span3" id="card-rut">
        <h2>Mis rutinas</h2>
        <p class="muted">Marca lo que haces cada día, por ejemplo beber agua. Si quieres, la página te manda un aviso para recordártelo.</p>
        <div class="notif"><p id="notif-txt"></p><button class="btn" id="notif-on" type="button">Activar avisos</button><button class="btn ghost" id="notif-test" type="button">Probar aviso</button></div>
        <div id="rut-list"></div>
        <h3 style="margin:16px 0 8px;font-size:16px">Agregar rutina</h3>
        <div class="chips" id="rut-add" style="margin-bottom:12px"></div>
        <form class="msg-form" id="rut-form"><input type="text" id="rut-new" maxlength="30" placeholder="Mi propia rutina, por ejemplo: leer 10 minutos" aria-label="Nueva rutina"><button class="btn" type="submit">Agregar</button></form>
      </div>
      <div class="card">
        <h2>Fondo</h2>
        <div class="bgs" id="bgs"></div>
        <button class="btn ghost block" id="bg-up" type="button">Subir imagen de fondo</button>
        <button class="btn ghost block" id="bg-del" type="button" style="margin-top:10px" hidden>Quitar mi imagen</button>
        <input type="file" id="f-bg" accept="image/*" hidden>
        <p class="muted" id="bg-msg" role="status" style="margin:10px 0 0"></p>
      </div>
      <div class="card">
        <h2>Brillitos</h2>
        <div class="switch-row">
          <p class="muted">Destellos suaves sobre el fondo</p>
          <button class="sw" id="sw-sp" type="button" role="switch" aria-checked="false" aria-label="Brillitos"></button>
        </div>
      </div>
      <div class="card">
        <h2>Borrar</h2>
        <p class="muted">Se quitan la foto, el marco, el fondo, el apodo y los brillitos.</p>
        <button class="btn ghost block" id="b-borrar" type="button"><svg class="i"><use href="#i-trash"/></svg>Borrar mi perfil</button>
      </div>
    </div>
  </section>
</main>

<nav class="bnav" id="bnav" aria-label="Principal">
  <button class="fab" data-go="registro" data-today="1" aria-label="Registrar hoy"><svg class="i"><use href="#i-plus"/></svg></button>
</nav>

<div class="card tip" id="tip" role="status" hidden>
