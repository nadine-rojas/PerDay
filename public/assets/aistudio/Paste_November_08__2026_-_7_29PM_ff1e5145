/* Fiestas */
function holActive(h,now=new Date()){
  const t=new Date(now.getFullYear(),now.getMonth(),now.getDate(),12);
  for(const yr of [now.getFullYear()-1,now.getFullYear(),now.getFullYear()+1]){
    const diff=Math.round((new Date(yr,h.m-1,h.d,12)-t)/864e5);
    if(diff>=-h.a&&diff<=h.b) return yr;
  }
  return null;
}
function holNext(h){
  const n=new Date(), t=new Date(n.getFullYear(),n.getMonth(),n.getDate(),12);
  for(const yr of [n.getFullYear(),n.getFullYear()+1]){
    const diff=Math.round((new Date(yr,h.m-1,h.d,12)-t)/864e5);
    if(diff>=0) return diff;
  }
  return 0;
}
function renderFest(){
  $('#fest-list').innerHTML=HOL.map(h=>{
    const act=holActive(h)!==null, own=regalos.filter(g=>g.k===h.id).length;
