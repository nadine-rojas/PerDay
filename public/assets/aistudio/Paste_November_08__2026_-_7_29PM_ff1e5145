    const gr=g.createLinearGradient(0,0,180,180);gr.addColorStop(0,'#6FD3A4');gr.addColorStop(1,'#6FA8D6');
    g.fillStyle=gr;g.beginPath();g.arc(90,90,90,0,Math.PI*2);g.fill();
