function rstreak(it){
  let n=0;const d=new Date();
  if(rcount(it.id,iso(d))<it.goal) d.setDate(d.getDate()-1);
  while(n<400&&rcount(it.id,iso(d))>=it.goal){n++;d.setDate(d.getDate()-1)}
  return n;
}
const rpct=it=>Math.min(100,Math.round(rcount(it.id)/it.goal*100));
function rutCard(it){
  const c=rcount(it.id), st=rstreak(it);
  const cfg=it.rem?`<div class="rut-cfg"><label>Cada<select data-f="every">${EVERY.map(([v,l])=>`<option value="${v}"${v===it.every?' selected':''}>${l}</option>`).join('')}</select></label><label>Desde<input type="time" data-f="from" value="${it.from}"></label><label>Hasta<input type="time" data-f="to" value="${it.to}"></label></div>`:'';
  return `<div class="rut" data-id="${esc(it.id)}">
<div class="rut-h"><span class="rut-e" aria-hidden="true">${it.e}</span><h3>${esc(it.n)}</h3><button class="btn ghost rdel" type="button" data-act="del" aria-label="Quitar ${esc(it.n)}"><svg class="i"><use href="#i-trash"/></svg></button></div>
<div class="rut-p"><button class="rbtn minus" type="button" data-act="minus" aria-label="Restar uno">−</button><div class="rut-m"><b>${c} de ${it.goal} ${runit(it)} hoy</b><div class="rbar"><i style="--w:${rpct(it)}%"></i></div></div><button class="rbtn" type="button" data-act="plus" aria-label="Sumar uno">+</button></div>
<p class="muted">${c>=it.goal?'¡Meta de hoy cumplida! 🎉':'Meta diaria'}${st?` · 🔥 ${st} ${st===1?'día':'días'} seguidos`:''}</p>
<div class="rut-cfg"><label>Meta por día<input type="number" min="1" max="20" value="${it.goal}" data-f="goal"></label></div>
<div class="switch-row" style="margin:12px 0 0"><p>Avisarme con una notificación</p><button class="sw" type="button" role="switch" data-act="rem" aria-checked="${!!it.rem}" aria-label="Avisarme: ${esc(it.n)}"></button></div>
${cfg}</div>`;
}
function rutMini(it){
  const c=rcount(it.id);
  return `<div class="rmini" data-id="${esc(it.id)}"><span aria-hidden="true">${it.e}</span><div class="rut-m"><b>${esc(it.n)}<small>${c}/${it.goal}</small></b><div class="rbar"><i style="--w:${rpct(it)}%"></i></div></div><button class="rbtn" type="button" data-act="plus" aria-label="Sumar uno a ${esc(it.n)}">+</button></div>`;
}
function renderRutinas(){
  const L=$('#rut-list');
  if(L) L.innerHTML=rut.items.map(rutCard).join('')||'<p class="muted">Todavía no tienes rutinas. Agrega una abajo.</p>';
  const A=$('#rut-add');
  if(A) A.innerHTML=RUT_PRE.filter(p=>!rut.items.some(x=>x.id===p.id)).map(p=>`<button class="chip" type="button" data-add="${p.id}">+ ${p.e} ${p.n}</button>`).join('');
  const H=$('#rut-hoy');
  if(H) H.innerHTML=rut.items.length?rut.items.map(rutMini).join(''):'<p class="muted" style="margin:0 0 12px">Agrega rutinas en tu perfil.</p>';
  renderNotif();
}
function rutClick(e){
  const b=e.target.closest('[data-act]'); if(!b) return;
  const box=b.closest('[data-id]'); if(!box) return;
  const it=rut.items.find(x=>x.id===box.dataset.id); if(!it) return;
  const a=b.dataset.act;
  if(a==='plus') rbump(it.id,1);
  else if(a==='minus') rbump(it.id,-1);
  else if(a==='rem'){
    it.rem=!it.rem;
    if(it.rem){remLast[it.id]=Date.now();store.set('menarca_remlast',remLast);if(notifState()==='default')askNotif()}
    saveRut();renderRutinas();
  }
  else if(a==='del'){
    if(confirm('¿Quitar esta rutina?')){rut.items=rut.items.filter(x=>x!==it);saveRut();renderRutinas()}
  }
}
function rutChange(e){
  const t=e.target,f=t.dataset.f; if(!f) return;
  const box=t.closest('[data-id]'); if(!box) return;
  const it=rut.items.find(x=>x.id===box.dataset.id); if(!it) return;
  if(f==='goal') it.goal=Math.max(1,Math.min(20,Math.round(+t.value)||1));
  else if(f==='every') it.every=+t.value||90;
  else if((f==='from'||f==='to')&&t.value) it[f]=t.value;
  saveRut();renderRutinas();
}
const notifState=()=>('Notification' in window)?Notification.permission:'unsupported';
function renderNotif(){
  const st=notifState();
  const msg={
    unsupported:'Este navegador no permite avisos del sistema. Verás el recordatorio dentro de la página.',
    granted:'Avisos activados ✓ Llegan mientras esta página esté abierta, aunque esté en otra pestaña o minimizada.',
    denied:'Los avisos están bloqueados. Actívalos desde el candado de la barra de direcciones y vuelve a cargar la página.',
    default:'Activa los avisos para que el dispositivo te recuerde beber agua.'
  }[st];
  const t=$('#notif-txt'); if(t) t.textContent=msg;
  const b=$('#notif-on'); if(b) b.hidden=(st==='granted'||st==='unsupported');
}
async function askNotif(){
  if('Notification' in window){try{await Notification.requestPermission()}catch(e){}}
  renderNotif();
}
function notify(title,body,id){
  let shown=false;
  if('Notification' in window&&Notification.permission==='granted'){
    try{
      const n=new Notification(title,{body,icon:ICON||undefined,tag:'menarca-'+id});
      n.onclick=()=>{try{window.focus()}catch(_){}n.close()};
      shown=true;
    }catch(e){}
  }
  if(!shown) showTip(title+' '+body);
}
const hm=t=>{const [h,m]=(t||'0:0').split(':').map(Number);return (h||0)*60+(m||0)};
function tick(){
  checkCelebs();
  const now=new Date(), mins=now.getHours()*60+now.getMinutes();
  rut.items.forEach(it=>{
    if(!it.rem) return;
    const a=hm(it.from), b=hm(it.to);
    const inWin=a<=b?(mins>=a&&mins<=b):(mins>=a||mins<=b);
    if(!inWin||rcount(it.id)>=it.goal) return;
    if(Date.now()-(remLast[it.id]||0)<it.every*60000) return;
    remLast[it.id]=Date.now();store.set('menarca_remlast',remLast);
    const c=rcount(it.id);
    if(it.id==='agua') notify('💧 ¡Hora de beber agua!',`Llevas ${c} de ${it.goal} vasos hoy. Toma un vaso y anótalo en la página.`,it.id);
    else notify(`${it.e} ${it.n}`,`Recordatorio. Llevas ${c} de ${it.goal} hoy.`,it.id);
  });
}

